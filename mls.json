{
  "note": "This is an example config. Copy it to /etc/moonlight/mls.json",
  "tokens": ["supersecrettokenox0", "supersecrettokenox1"],
  "retry_count": 3,
  "port": 8080,
  "quic_port": 6000,
  "ws": {
    "enabled": true,
    "path": "/ws",
    "max_connections": 1000,
    "read_timeout": 300,
    "write_timeout": 30,
    "heartbeat_interval": 30,
    "connection_check_interval": 60
  },
  "html": {
    "enabled": true,
    "static_path": "/static",
    "index_path": "/",
    "dashboard_path": "/dashboard"
  },
